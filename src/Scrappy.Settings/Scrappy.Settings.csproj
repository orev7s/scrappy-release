<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      One source of truth: the schema is embedded from scrappy/schema, the generated file the
      app is required to build its settings list from. Regenerate with
      python3 scrappy/tools/gen_schema.py > scrappy/schema/scrcpy-options.json
    -->
    <EmbeddedResource Include="..\..\schema\scrcpy-options.json" LogicalName="scrcpy-options.json" />
    <EmbeddedResource Include="..\..\schema\scrcpy-options.explain.json" LogicalName="scrcpy-options.explain.json" />
  </ItemGroup>

</Project>
